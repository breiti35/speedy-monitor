<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Nur fuer den Zugriff auf die UIAutomationClient/-Types-Assemblies noetig
         (Ermittlung der Tray-Cluster-Position) - die UI selbst bleibt WinForms. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <AssemblyName>SpeedyMonitor</AssemblyName>
    <RootNamespace>NetSpeedMonitor</RootNamespace>
    <Product>Speedy Monitor</Product>
    <AssemblyTitle>Speedy Monitor</AssemblyTitle>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AppIcon.ico" LogicalName="NetSpeedMonitor.AppIcon.ico" />
  </ItemGroup>

</Project>